<view class="page">
  <!-- 统计卡片 -->
  <view class="stats">
    <view class="stat-card safe"><text class="num">{{safeCount}}</text><text class="lbl">安全</text></view>
    <view class="stat-card warn"><text class="num">{{warnCount}}</text><text class="lbl">即将过期</text></view>
    <view class="stat-card expired"><text class="num">{{expiredCount}}</text><text class="lbl">已过期</text></view>
  </view>

  <!-- 操作栏 -->
  <view class="toolbar">
    <input placeholder="🔍 搜索零食" bindinput="onSearch" value="{{searchText}}"/>
    <button size="mini" class="export-btn" bindtap="subscribeMsg">🔔 开启提醒</button>
  </view>

  <!-- 列表 -->
  <view class="list">
    <block wx:for="{{items}}" wx:key="_id">
      <view class="item-card {{item.status}}">
        <view class="card-left">
          <text class="item-name">{{item.name}}</text>
          <text class="item-brand">{{item.brand || '未填品牌'}}{{item.barcode ? ' | 条码:' + item.barcode : ''}}</text>
          <view class="item-dates">
            <text>生产：{{item.prodDate}}</text>
            <text>到期：{{item.expireDate}}</text>
            <text>保质：{{item.shelfDays}}天</text>
          </view>
        </view>
        <view class="card-right">
          <text class="remaining {{item.status}}">{{item.remaining}}<text class="unit">天</text></text>
          <text class="badge {{item.status}}">{{item.statusText}}</text>
          <view class="delete-btn" bindtap="deleteItem" data-id="{{item._id}}">✕</view>
        </view>
      </view>
    </block>
    <view class="empty" wx:if="{{items.length === 0}}">
      <text>暂无零食数据</text>
      <text class="sub">去「扫码识别」或「录入零食」页添加吧</text>
    </view>
  </view>
</view>
