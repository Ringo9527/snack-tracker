page { padding: 16px; }

.card { background: white; border-radius: 12px; padding: 20px; margin-bottom: 16px; }

.scan-btn { width: 100%; background: #4472C4; color: white; font-size: 16px; border-radius: 8px; }
.scan-btn:active { background: #3a62a8; }

.divider { display: flex; align-items: center; margin: 16px 0; color: #999; font-size: 13px; }
.divider::before, .divider::after { content: ''; flex: 1; height: 1px; background: #ddd; }
.divider text { padding: 0 12px; }

.barcode-input { margin-top: 4px; }
.barcode-input .label { font-size: 14px; color: #666; display: block; margin-bottom: 6px; }
.barcode-input input { width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 8px; font-size: 16px; }
.lookup-btn { width: 100%; background: #27ae60; color: white; font-size: 15px; border-radius: 8px; margin-top: 8px; }
.lookup-btn:active { background: #229954; }

.result { background: #e8f5e9; border-radius: 8px; padding: 12px; margin-top: 12px; }
.result-header { font-weight: 600; color: #4472C4; margin-bottom: 6px; }
.result-body { font-size: 14px; }

.history-card, .new-card { background: #f0f7ff; border: 1px solid #c3d4f5; border-radius: 8px; padding: 12px; margin-top: 8px; }
.h-top { display: flex; align-items: center; flex-wrap: wrap; }
.h-name { font-weight: 600; font-size: 15px; }
.h-brand { color: #888; font-size: 13px; }
.h-badge { font-size: 11px; padding: 2px 8px; border-radius: 10px; margin-left: 8px; }
.h-badge.safe { background: #e8f5e9; color: #27ae60; }
.h-badge.warn { background: #fff8e1; color: #f39c12; }
.h-badge.expired { background: #ffebee; color: #e74c3c; }
.h-info { display: flex; margin-top: 8px; gap: 8px; flex-wrap: wrap; }
.h-col { flex: 1; min-width: 70px; }
.hl { font-size: 11px; color: #888; display: block; }
.hv { font-weight: 500; color: #333; display: block; }
.hv.dim { color: #888; }

.tip-box { background: #fff3cd; border-radius: 8px; padding: 12px; font-size: 13px; color: #856404; line-height: 1.6; }
